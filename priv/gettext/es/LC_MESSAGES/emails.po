#: lib/amauta/accounts/user_notifier.ex:56
#, elixir-autogen, elixir-format
msgid "Confirmation instructions"
msgstr "Confirmá tu cuenta"

#: lib/amauta/accounts/user_notifier.ex:31
#, elixir-autogen, elixir-format
msgid "Hi %{name},\n\nYou can change your email by visiting the URL below:\n\n%{url}\n\nIf you didn't request this change, please ignore this.\n"
msgstr ""
"Hola, %{name}:\n"
"\n"
"Para confirmar tu nuevo email, entrá en este enlace:\n"
"\n"
"%{url}\n"
"\n"
"Si no pediste este cambio, ignorá este mensaje.\n"

#: lib/amauta/accounts/user_notifier.ex:57
#, elixir-autogen, elixir-format
msgid "Hi %{name},\n\nYou can confirm your account by visiting the URL below:\n\n%{url}\n\nIf you were not expecting this email, please ignore it.\n"
msgstr ""
"Hola, %{name}:\n"
"\n"
"Para confirmar tu cuenta y entrar, usá este enlace:\n"
"\n"
"%{url}\n"
"\n"
"Si no esperabas este email, ignoralo.\n"

#: lib/amauta/accounts/user_notifier.ex:80
#, elixir-autogen, elixir-format
msgid "Hi %{name},\n\nYou can log into your account by visiting the URL below:\n\n%{url}\n\nIf you didn't request this email, please ignore this.\n"
msgstr ""
"Hola, %{name}:\n"
"\n"
"Para entrar a tu cuenta, usá este enlace:\n"
"\n"
"%{url}\n"
"\n"
"Si no lo pediste, ignorá este mensaje.\n"

